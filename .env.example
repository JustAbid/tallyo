# Copy to server/.env and fill in your own values. Don't commit the real file.
PORT=3001

# PayPal Sandbox keys (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Gemini key from aistudio.google.com
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# The dashboard's chat agents use a stronger model, because Studio's tool definitions are intricate
AI_AGENT_MODEL=gemini-3-flash-preview

# AG Studio licence goes in client/.env.local (not here), as:
# VITE_AG_STUDIO_LICENSE=your-key
